# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OLLAMA_BASE_URL: Ollama server or cloud API endpoint (e.g. http://localhost:11434/v1 or https://ollama.com/v1)
OLLAMA_BASE_URL="http://localhost:11434/v1"

# OLLAMA_API_KEY: Optional API key for authenticated Ollama / OpenAI-compatible endpoints
OLLAMA_API_KEY="MY_OLLAMA_API_KEY"

# OLLAMA_MODEL: Model used for legal document drafting and assistant queries
OLLAMA_MODEL="qwen2.5-coder:7b"

# Client-side fallback variables
VITE_OLLAMA_BASE_URL="http://localhost:11434/v1"
VITE_OLLAMA_MODEL="qwen2.5-coder:7b"

# Optional SMTP configuration for direct email delivery
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password"

